# ----------------------------------------------------
# Marvel E-Commerce Environment Configuration (.env)
# ----------------------------------------------------

# Server Port
PORT=5000

# Supabase PostgreSQL Database Credentials
SUPABASE_URL=https://hyyjkyztxikohdywqagp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Secret for RBAC Token Issuance & Verification
# Required outside development and must be at least 32 characters. Generate one
# with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# Comma-separated browser origins allowed to call the API. Defaults to
# http://localhost:5173 and http://127.0.0.1:5173 when unset.
ALLOWED_ORIGINS=http://localhost:5173
