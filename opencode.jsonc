{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "npm publish *",
      "effect": "ask",
    },
  ],
  "watcher": {
    "ignore": ["dist/**", "coverage/**", "playwright-report/**", "test-results/**"],
  },
}
